// บ้านริมภู · Cloudflare Worker + D1 — คำสั่งที่ใช้ดูใน package.json (scripts)
{
  "name": "banrimphoo",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // หน้าเว็บ — ทุกคำขอผ่าน Worker ก่อน (เช็กล็อกอิน) แล้วค่อยส่งไฟล์จาก public/
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    // database_id: ได้จากคำสั่ง  npx wrangler d1 create banrimphoo  แล้วนำมาใส่แทน
    { "binding": "DB", "database_name": "banrimphoo", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "observability": { "enabled": true }
}

// บ้านริมภู · Cloudflare Worker + D1 — คำสั่งที่ใช้ดูใน package.json (scripts)
{
  "name": "banrimphoo",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // หน้าเว็บ — ทุกคำขอผ่าน Worker ก่อน (เช็กล็อกอิน) แล้วค่อยส่งไฟล์จาก public/
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    // ฐานข้อมูล D1 บน Cloudflare (สร้างแล้ว, region APAC) — database_id ไม่ใช่ความลับ
    { "binding": "DB", "database_name": "banrimphoo", "database_id": "37204096-0b86-45b8-82d0-a3f83900aed0", "migrations_dir": "migrations" }
  ],
  // Smart Placement: ให้ Cloudflare ย้าย Worker ไปรันใกล้ฐานข้อมูล ถ้าช่วยให้เร็วขึ้น (คำขอหนึ่งเรียก D1 หลายครั้ง)
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
